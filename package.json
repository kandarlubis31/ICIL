  "scripts": {
    "search": "node load-context.js",
    "list": "node load-context.js --list",
    "mcp": "node mcp-server.js",
    "mcp:smoke": "node scripts/mcp-smoke.js",
    "test": "node --test",
    "verify": "npm test && npm audit --omit=dev --audit-level=high && node ci-validate.js --with-eval && npm run ci:faculty && npm run mcp:smoke",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run verify",
    "eval": "node eval-runner.js",
    "eval:abstention": "node eval-runner.js --abstention",
    "eval:json": "node eval-runner.js --json",
    "eval:ci": "node eval-runner.js --ci",
    "ci:validate": "node ci-validate.js",
    "ci:gate": "node ci-validate.js --with-eval",
    "ci:faculty": "node ci-faculty.js --all",
    "audit:loop": "node audit/audit-runner.js",
    "audit:status": "node audit/audit-runner.js --status"
  },
